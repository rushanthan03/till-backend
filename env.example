# ---- Database (PostgreSQL 12+) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=root
DATABASE_NAME=till_pos

# ---- Auth ----
JWT_ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRATION_TIME=1h
JWT_REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d

# ---- App ----
# development = tables are created/updated automatically (use for local demo)
# production  = no auto sync, run migrations instead (npm run migration:run)
NODE_ENV=development
PORT=4000

# ---- First super admin (used by the seeder) ----
SUPER_ADMIN_EMAIL=admin@till.local
SUPER_ADMIN_PASSWORD=Admin@12345

# ---- Optional: logo/banner uploads to AWS S3 (skip if not uploading images) ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# ---- Production only (see README "Production checklist") ----
# The app refuses to start in production with placeholder secrets, a default DB password or no CORS_ORIGINS.
# CORS_ORIGINS=https://till.yourshop.com            comma-separated web addresses allowed to call the API
# TRUST_PROXY=true                                  set when behind a load balancer / reverse proxy
# DATABASE_SSL=true                                 true (default in production) | false (private network) | strict (verify certificate)
# PAYMENT_PROVIDER=simulated                        simulated takes NO money; set a real provider before live card payments
# ENABLE_SWAGGER=false                              API docs are off in production unless true

# Email (receipts and password resets). Without these, emails are saved to tmp/mail/ in development
# and refused in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
